{
  "dart.flutterSdkPath": "/home/mhmd/projects/flutter",
  "terminal.integrated.env.linux": {
    "ANDROID_HOME": "/home/mhmd/Android/Sdk",
    "ANDROID_SDK_ROOT": "/home/mhmd/Android/Sdk",
    "PATH": "${env:PATH}:/home/mhmd/projects/flutter/bin:/home/mhmd/Android/Sdk/cmdline-tools/latest/bin:/home/mhmd/Android/Sdk/platform-tools:/home/mhmd/Android/Sdk/emulator"
  },
  "git.ignoreLimitWarning": true,
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "file": ".github/instructions/tokenshield.instructions.md"
    }
  ],
  "mcp": {
    "servers": {
      "headroom": {
        "command": "headroom",
        "args": [
          "mcp",
          "serve"
        ],
        "type": "stdio",
        "env": {
          "HEADROOM_BEACON": "off",
          "HEADROOM_TELEMETRY": "off",
          "HEADROOM_OFFLINE": "1",
          "DO_NOT_TRACK": "1"
        }
      },
      "token-cache": {
        "command": "node",
        "args": [
          "/home/mhmd/.vscode/extensions/sarfudheen.tokenshield-1.0.18/dist/cache-server.js",
          "/home/mhmd/projects/3ialna"
        ],
        "type": "stdio"
      }
    }
  },
  "github.copilot.chat.codesearch.exclude": {
    "*.lock": true,
    "*.min.js": true,
    "*.min.css": true,
    "*.map": true,
    "*.d.ts": true,
    "*.generated.*": true,
    "dist/**": true,
    "build/**": true,
    "coverage/**": true,
    ".git/**": true,
    "node_modules/**": true,
    ".next/**": true,
    ".nuxt/**": true,
    "__pycache__/**": true,
    "*.pyc": true,
    "*.pyo": true,
    "target/**": true,
    "vendor/**": true
  }
}